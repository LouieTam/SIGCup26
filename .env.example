# Copy to .env and fill in. .env is gitignored — never commit the real key.
#
# Create a key at https://sig.thesuper.market -> My Profile -> API Keys.
# Scopes needed: `read` for data collection, `read`+`trade` to place orders.
SIG_API_KEY=

# Optional. Defaults to https://sig.thesuper.market/api/v1
# SIG_API_BASE=
